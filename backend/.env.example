# Copy to .env and fill in. Never commit the real .env file.

# development here is correct for local `npm run dev`. When running inside
# Docker Compose (docker-compose.yml), this is deliberately overridden to
# "production" so the container doesn't try to load dev-only tooling
# (like pino-pretty) that isn't installed in the production image.
NODE_ENV=development
PORT=3000

# Overridden by docker-compose.yml when running in containers. No TLS here
# on purpose — the local Postgres/Redis containers don't have certs
# configured, and setting that up buys nothing on a machine only you can
# reach. Production enforces TLS on both (infrastructure/terraform's
# rds.tf `rds.force_ssl=1` + secrets.tf's `?sslmode=require`, and redis.tf's
# `transit_encryption_enabled` + the `rediss://` scheme) — see the
# "Security" section in the root README.
DATABASE_URL=postgresql://ghsa:ghsa_dev_password@localhost:5432/ghana_super_app
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_dev_only_access_secret
JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# OTP
OTP_TTL_MIN=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# SMS provider — "console" logs OTPs instead of sending them (local dev only).
# Swap to "twilio" / "hubtel" / "africastalking" once real credentials exist;
# see src/modules/auth/otp.provider.ts.
SMS_PROVIDER=console
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=GhanaSuperApp

# Payment gateway webhook — HMAC-SHA256 shared secret used to verify that
# POST /payments/webhook really came from the payment gateway (or, in dev,
# from scripts/simulate-gateway-webhook.ts) rather than from a customer
# trying to mark their own payment as PAID. Generate a real one with
# `openssl rand -hex 32` before this ever runs anywhere but your laptop.
PAYMENT_WEBHOOK_SECRET=change_me_dev_only_webhook_secret_please_rotate

# Field-level encryption for PII at rest (phone/name/email — see
# src/common/crypto/piiEncryption.ts). Generate real values before this
# runs anywhere but your laptop: PII_ENCRYPTION_KEY with
# `openssl rand -hex 32` (must stay exactly 64 hex chars — it's an AES-256
# key), PII_HASH_KEY with `openssl rand -hex 32` too (any length >=16 works,
# hex is just convenient). Changing either key after real data has been
# written makes that data undecryptable / unlookupable — rotate by
# re-encrypting all rows under the new key, never by just swapping the env
# var.
PII_ENCRYPTION_KEY=67c8ad5e5aa5669b46ce7278e9424ad7d9ef5c6ab6a8f169dba4d741fcdb4108
PII_HASH_KEY=change_me_dev_only_hash_key_please_rotate

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=100

# Matching (spec §17) — nearby-driver search radius
MATCHING_INITIAL_RADIUS_KM=3
MATCHING_MAX_RADIUS_KM=8

# CORS — the frontend's origin. "*" is fine for local dev; set this to
# your real frontend URL in production.
CORS_ORIGIN=*
